# Exemplo de variáveis de ambiente
# Copie para .env e ajuste conforme necessário

APP_NAME="Eorzea Companion AI"
DEBUG=true
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
DEFAULT_CHARACTER=lauda

# Memória
MEMORY_DB_PATH=data/memories.db
